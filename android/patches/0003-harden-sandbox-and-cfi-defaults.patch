From: Micromium <micromium@example.local>
Date: Mon, 21 Sep 2026 00:00:00 +0000
Subject: [PATCH 3/7] Harden sandbox + CFI defaults (Micromium)

- Turns on Control-Flow Integrity where the toolchain supports it
- Actual enforcement flags live in <platform>/args.gn; this patch only
  changes defaults so a plain `gn gen` stays hardened.

Rebased against Chromium 153.0.8010.27 (branch 1681091).

--- a/sandbox/policy/features.cc
+++ b/sandbox/policy/features.cc
@@ -15,3 +15,4 @@
 namespace sandbox::policy::features {
 
+constexpr bool kMicromiumSandboxHardenedByDefault = true;
 #if !BUILDFLAG(IS_MAC) && !BUILDFLAG(IS_FUCHSIA)
--- a/build/config/compiler/compiler.gni
+++ b/build/config/compiler/compiler.gni
@@ -15,2 +15,7 @@
 import("//build/toolchain/toolchain.gni")
+declare_args() {
+  # Micromium hardening knob; platform args set the safe default.
+  # Pass micromium_hardened=false for debugging.
+  micromium_hardened = true
+}
 import("//build_overrides/build.gni")
