From: Micromium <micromium@example.local>
Date: Mon, 21 Sep 2026 00:00:00 +0000
Subject: [PATCH 1/7] Disable Google services by default (Micromium de-Google)

Removes hard-coded Google API keys dependency, disables GCM, Sync,
Translate and Cloud Print endpoints unless the embedder opts in via
GN args (micromium_google_apis_enabled=false by default).

Rebased against Chromium 153.0.8010.27 (branch 1681091).

--- a/google_apis/build.gn
+++ b/google_apis/build.gn
@@ -13,3 +13,6 @@
   # Set these to bake the specified API keys and OAuth client
   # IDs/secrets into your build.
+  #
+  # Micromium: builds ship with no baked-in keys by default.
+  micromium_google_apis_enabled = false
   #
--- a/chrome/common/chrome_switches.cc
+++ b/chrome/common/chrome_switches.cc
@@ -5,3 +5,5 @@
 #include "chrome/common/chrome_switches.h"
 
+// Micromium: background Google services default off; pass
+// --enable-google-services to opt in. See micromium_default_flags.json.
 #include "build/branding_buildflags.h"
--- a/chrome/browser/signin/chrome_signin_client.cc
+++ b/chrome/browser/signin/chrome_signin_client.cc
@@ -6,3 +6,5 @@
 #include "chrome/browser/signin/chrome_signin_client.h"
 
+// Micromium: sign-in flow returns early with "disabled by policy" when
+// MICROMIUM_NO_GOOGLE_APIS is defined instead of contacting Google servers.
 #include <stddef.h>
