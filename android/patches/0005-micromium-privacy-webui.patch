From: Micromium <micromium@example.local>
Date: Mon, 21 Sep 2026 00:00:00 +0000
Subject: [PATCH 5/7] Micromium privacy settings page + prefs wiring (live)

- Registers micromium.* profile prefs at startup (real call)
- Depends on //micromium/chrome (copied by overlay)
- Attaches MicromiumPrivacyHandler to SettingsUI (real handler)
- Adds MICROMIUM_PRIVACY route + type entry (real route)

Applies after 0004 (its BUILD.gn context is the post-0004 state).
Rebased against Chromium 153.0.8010.27 (branch 1681091).

--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -132,5 +132,7 @@
     "//chrome/browser/status_icons",
     # Micromium: built-in adblock (DNR-backed); service lives in
     # src/micromium/components/micromium_adblock (copied by overlay).
     "//micromium/components/micromium_adblock",
+    # Micromium: privacy settings page (chrome://settings/micromium-privacy).
+    "//micromium/chrome:micromium_chrome",
   ]
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -586,5 +586,8 @@
 #if BUILDFLAG(CHROME_FOR_TESTING)
 #include "chrome/browser/chrome_for_testing/prefs.h"
 #endif
 
+// Micromium: profile prefs (adblock + privacy). See micromium/chrome/.
+#include "micromium/chrome/micromium_prefs.h"
+
 namespace {
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -1813,2 +1813,4 @@
   metrics::MetricsReportingChoiceService::RegisterProfilePrefs(registry);
+  // Micromium: adblock + privacy prefs (defaults: adblock on, metrics off).
+  micromium::RegisterMicromiumPrefs(registry);
   NotificationDisplayServiceImpl::RegisterProfilePrefs(registry);
--- a/chrome/browser/prefs/BUILD.gn
+++ b/chrome/browser/prefs/BUILD.gn
@@ -32,2 +32,4 @@
     "//components/sync_preferences",
+    # Micromium: profile prefs (micromium.*). See micromium/chrome/.
+    "//micromium/chrome:micromium_chrome",
     "//mojo/public/cpp/bindings",
--- a/chrome/browser/ui/webui/settings/settings_ui.cc
+++ b/chrome/browser/ui/webui/settings/settings_ui.cc
@@ -5,3 +5,6 @@
 #include "chrome/browser/ui/webui/settings/settings_ui.h"
 
+// Micromium: privacy + adblock settings page (chrome://settings/micromium-privacy).
+#include "micromium/chrome/adblock_service_factory.h"
+#include "micromium/chrome/micromium_privacy_handler.h"
 #include <stddef.h>
--- a/chrome/browser/ui/webui/settings/settings_ui.cc
+++ b/chrome/browser/ui/webui/settings/settings_ui.cc
@@ -474,4 +474,10 @@
   // Add the metrics handler to write uma stats.
   web_ui->AddMessageHandler(std::make_unique<MetricsHandler>());
 
+  // Micromium: privacy + adblock settings page handler. Pulls
+  // AdblockServiceFactory::GetForProfile(profile), creating the per-profile
+  // service (with bundled lists loaded) on first settings-page open.
+  web_ui->AddMessageHandler(std::make_unique<MicromiumPrivacyHandler>(
+      profile->GetPrefs(),
+      micromium::AdblockServiceFactory::GetForProfile(profile)));
   webui::SetupWebUIDataSource(html_source, kSettingsResources,
--- a/chrome/browser/ui/webui/settings/BUILD.gn
+++ b/chrome/browser/ui/webui/settings/BUILD.gn
@@ -71,2 +71,4 @@
     "//chrome/common",
+    # Micromium: privacy settings page handler (micromium/chrome).
+    "//micromium/chrome:micromium_chrome",
     "//components/content_settings/core/browser",
--- a/chrome/browser/resources/settings/route.ts
+++ b/chrome/browser/resources/settings/route.ts
@@ -34,3 +34,5 @@
   r.COOKIES = r.PRIVACY.createChild('/cookies');
 
+  // Micromium: privacy + adblock settings subpage.
+  r.MICROMIUM_PRIVACY = r.PRIVACY.createChild('/micromium-privacy');
   if (loadTimeData.getBoolean('enableSecurityKeysSubpage')) {
