From: Micromium <micromium@example.local>
Date: Mon, 21 Sep 2026 00:00:00 +0000
Subject: [PATCH 4/7] Wire MicromiumAdblock into chrome/browser (DNR)

Adds the GN dependency on the overlay component. The service sources live
in src/micromium/components/micromium_adblock/ (copied by overlay), so
this patch stays small and rebases cleanly.

Rebased against Chromium 153.0.8010.27 (branch 1681091).

--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -125,9 +125,12 @@
 source_set("browser_process") {
   sources = [
     "browser_process.cc",
     "browser_process.h",
   ]
   deps = [
     "//base",
     "//chrome/browser/status_icons",
+    # Micromium: built-in adblock (DNR-backed); service lives in
+    # src/micromium/components/micromium_adblock (copied by overlay).
+    "//micromium/components/micromium_adblock",
   ]
--- a/chrome/browser/about_flags.cc
+++ b/chrome/browser/about_flags.cc
@@ -9,3 +9,5 @@
 #include "chrome/browser/about_flags.h"
 
+// Micromium: chrome://flags/#micromium-adblock (default ENABLED via
+// --enable-features=MicromiumAdblock; see default flags).
 #include <iterator>
